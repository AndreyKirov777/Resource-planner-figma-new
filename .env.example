# Database URL (SQLite). Canonical value below: `file:./dev.db` is resolved by Prisma relative to the
# schema directory (prisma/), so both the Prisma CLI and the client read the SAME file: prisma/dev.db.
# The server (server.ts) falls back to the same absolute prisma/dev.db path when DATABASE_URL is unset,
# so all tiers agree on one database. Do not use `file:./prisma/dev.db` — that resolves to prisma/prisma/dev.db.
# `?connection_limit=1` keeps every tier on a single SQLite connection (see WAL note in DEPLOYMENT.md).
DATABASE_URL=file:./dev.db?connection_limit=1

# --- Authentication ---

# "entra" (default, production) signs in via Microsoft Entra ID. "dev" serves a fixture-user chooser
# at GET /auth/login instead and is refused at startup when NODE_ENV=production.
AUTH_MODE=dev

# Signs and encrypts the short-lived PKCE/state/nonce cookie used during the Entra sign-in flow.
# Required whenever AUTH_MODE=entra. Generate with `openssl rand -base64 32`.
SESSION_SECRET=

# Entra ID (Azure AD) app registration — required when AUTH_MODE=entra. See DEPLOYMENT.md for the
# registration steps (redirect URIs, client secret, and the `groups` claim on the ID token).
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_REDIRECT_URI=http://localhost:3001/auth/callback

# Entra security-group object ids mapped to Resource Planner groups. Checked in this order
# (ADMIN > MANAGER > USER); a signed-in user matching none of these AND not listed in
# ADMIN_EMAILS gets the "no access" page and no User row is created.
ENTRA_GROUP_ADMIN=
ENTRA_GROUP_MANAGER=
ENTRA_GROUP_USER=

# Comma-separated emails (case-insensitive) that always resolve to ADMIN, regardless of Entra
# group membership. Used to bootstrap the first admin before any Entra groups are configured.
ADMIN_EMAILS=

# --- Cookies / transport ---

# "true" forces the session cookie's Secure flag on; "false" forces it off. Unset defaults to
# true in production (NODE_ENV=production) and false otherwise, so local dev over http works.
COOKIE_SECURE=

# Set to "1" when the app runs behind a reverse proxy terminating TLS (see DEPLOYMENT.md) so
# Express trusts X-Forwarded-* headers and secure cookies work correctly.
TRUST_PROXY=

# Public TEST hostname uses the IPA-issued PEM in ./certs (mounted at /etc/caddy/certs).
# The legacy IPA DNS name keeps Caddy's local CA so old bookmarks still open.
{$SITE_ADDRESS:resource-planner-test.dataart.com} {
	tls /etc/caddy/certs/fullchain.pem /etc/caddy/certs/key.pem
	encode gzip
	reverse_proxy app:3001
}

marenas-aiagent-vm.ipa.dataart.net {
	tls internal
	encode gzip
	reverse_proxy app:3001
}

# Dependencies
node_modules

# Build output (Vite uses "build" per vite.config.ts)
build
dist

# Vite cache
.vite

# Keep environment variables out of version control
.env
.env.local
.env.*.local

# Generated code
/src/generated/prisma

# Logs and runtime
*.log
npm-debug.log*
logs/
.app*.pids

# SQLite database (keep data local; do not commit)
prisma/dev.db

# Disposable test databases (recreated fresh on every `npm test` run)
prisma/test.db*
prisma/test-*.db*

# Local deploy overrides (optional)
scripts/deploy.config.local.sh

# Optional: uncomment if you don't want to share editor/IDE config
# .vscode
# .cursor

# macOS Finder "copy" duplicates (e.g. "file 2.ts")
* 2.*

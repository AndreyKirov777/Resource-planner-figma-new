// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Project {
  id              Int             @id @default(autoincrement())
  name            String
  description     String?
  daysInFTE       Int             @default(21)
  clientCurrency  String          @default("EUR")
  exchangeRate    Float           @default(0.89)
  defaultMargin   Float?          @default(45.0)
  planningMode    String          @default("weekly")
  defaultLocation String?         @default("ukraine")
  phases          String?         @default("[{\"name\":\"Phase 1\",\"periodCount\":8,\"color\":\"#E3F2FD\"}]")
  // Anchors period 1 for the roadmap's calendar labels; null = ordinals only.
  startDate       DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  resourceLists   ResourceList[]
  resourcePlans   ResourcePlan[]
  wbsItems        WbsItem[]
  roadmapLanes    RoadmapLane[]
  roadmapItems    RoadmapItem[]
}

// Rate card is global: a single shared set common to all projects.
model GlobalRateCard {
  id              Int             @id @default(autoincrement())
  role            String
  namingInPM      String
  discipline      String
  description     String?
  ukraine         Float
  easternEurope   Float
  asiaGE          Float
  asiaARMKZ       Float
  latam           Float
  mexico          Float
  india           Float
  newYork         Float
  london          Float
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

// Singleton (id = 1) holding metadata about the last rate card import.
model RateCardImportMeta {
  id              Int             @id @default(1)
  fileName        String?
  importedAt      DateTime?
  updatedAt       DateTime        @updatedAt
}

model ResourceList {
  id              Int             @id @default(autoincrement())
  role            String
  clientRole      String?
  name            String?
  intRate         Float
  location        String?
  description     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  // Relations
  projectId       Int
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model ResourcePlan {
  id              Int             @id @default(autoincrement())
  role            String
  clientRole      String?         // Added client role field
  name            String?
  intHourlyRate   Float
  clientHourlyRate Float
  displayOrder    Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  // Relations
  projectId       Int
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  allocations     Allocation[]
}

model Allocation {
  id              Int             @id @default(autoincrement())
  periodNumber    Int
  allocation      Int             @default(0) // Percentage allocation (0-100)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  resourcePlanId  Int
  resourcePlan    ResourcePlan    @relation(fields: [resourcePlanId], references: [id], onDelete: Cascade)

  @@unique([resourcePlanId, periodNumber])
}

// Work Breakdown Structure: self-referencing tree of work items per project,
// each optionally carrying a vector of multi-disciplinary hour estimates.
model WbsItem {
  id              Int             @id @default(autoincrement())
  name            String
  parentId        Int?
  displayOrder    Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // phaseName: NULL = Unassigned; matched to Project.phases by name (not a FK).
  phaseName       String?

  // Relations
  projectId       Int
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent          WbsItem?        @relation("WbsTree", fields: [parentId], references: [id], onDelete: Cascade)
  children        WbsItem[]       @relation("WbsTree")
  estimates       WbsEstimate[]
  // "This node, with its subtree, is delivered by that roadmap item." Relation field
  // only — WbsItem's own columns are untouched, per the roadmap SPEC's constraint.
  roadmapLink     RoadmapLink?
}

// Multi-disciplinary hour estimate for a WbsItem: one row per (item, discipline, role).
model WbsEstimate {
  id              Int             @id @default(autoincrement())
  discipline      String
  role            String          @default("")
  hours           Float           @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  // Relations
  wbsItemId       Int
  wbsItem         WbsItem         @relation(fields: [wbsItemId], references: [id], onDelete: Cascade)

  @@unique([wbsItemId, discipline, role])
}

// ---------------------------------------------------------------------------
// Project Roadmap (Slice A) — see _bmad-output/specs/spec-roadmap/data-model.md
// Flat by design: lanes hold items; items hold nothing. No nesting.
// ---------------------------------------------------------------------------

// A workstream row on the roadmap. Order is explicit, like ResourcePlan.displayOrder.
model RoadmapLane {
  id              Int             @id @default(autoincrement())
  name            String
  displayOrder    Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  projectId       Int
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  items           RoadmapItem[]
}

// A window or milestone inside a lane. Flat: no parent, ever.
model RoadmapItem {
  id              Int             @id @default(autoincrement())
  name            String
  kind            String          @default("bar")  // "bar" | "milestone" | "spread"
  startPeriod     Int                               // 1-based, in the project's planningMode unit
  periodCount     Int             @default(1)       // >= 1 for bars; 0 for milestones AND for spread items
  // A "spread" item (Slice B) demands evenly across the WHOLE project, not a
  // window of it — it is not draggable/resizable. Its startPeriod/periodCount
  // are a fixed sentinel (1, 0), exactly like a milestone's periodCount
  // sentinel; the demand engine (roadmapLoad.ts) never reads them for a
  // spread item and always spans [1, projectPeriodCount] instead.
  displayOrder    Int             @default(0)
  // Planner-picked fill for bars / spreads / milestones. Palette is
  // PHASE_COLORS (see src/utils/roadmapColors.ts); default matches the
  // historic accent so existing roadmaps look unchanged until recoloured.
  color           String          @default("#8f4f8f")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  laneId          Int
  lane            RoadmapLane     @relation(fields: [laneId], references: [id], onDelete: Cascade)
  projectId       Int             // denormalised so the link/project invariant check is one query
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  links           RoadmapLink[]
}

// "This WBS node, with its subtree, is delivered by that roadmap item."
// Lives in its own table so WbsItem does not change. Absent row = not linked directly.
model RoadmapLink {
  id              Int             @id @default(autoincrement())
  createdAt       DateTime        @default(now())

  wbsItemId       Int             @unique
  wbsItem         WbsItem         @relation(fields: [wbsItemId], references: [id], onDelete: Cascade)
  roadmapItemId   Int
  roadmapItem     RoadmapItem     @relation(fields: [roadmapItemId], references: [id], onDelete: Cascade)
}
